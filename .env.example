# ---------------------------------------------------------------------------
# EDEN: Luxury Management - variables d'environnement
# ---------------------------------------------------------------------------
# Copiez ce fichier vers `.env.local` (qui est ignore par git) et remplacez
# les valeurs de remplacement par celles de VOTRE projet Supabase.
#
# `.env.local` ne doit JAMAIS etre commit, archive ni transmis a un client.
# Seul le contenu de ce fichier d'exemple doit circuler.
# ---------------------------------------------------------------------------

# URL du projet Supabase (Settings > API > Project URL).
# Valeur attendue par l'application : une URL de la forme https://<ref>.supabase.co
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Cle publique "anon / publishable" (Settings > API > Project API keys).
# Cette cle est concue pour etre exposee au navigateur : elle est protegee
# par les politiques RLS de la base, pas par le secret.
VITE_SUPABASE_ANON_KEY=votre-cle-anon-supabase

# ---------------------------------------------------------------------------
# Cle de jeton d'API de gestion Supabase (SUPABASE_ACCESS_TOKEN)
# ---------------------------------------------------------------------------
# L'EDEN est une application 100 % client (Vite + React). Elle n'a besoin
# QUE des deux variables ci-dessus. Aucun code du projet ne lit un jeton
# d'API de gestion : `SUPABASE_ACCESS_TOKEN` n'est donc pas requis ici.
#
# Si vous devez utiliser la CLI Supabase (`supabase link`, `supabase db push`),
# le jeton s'obtient dans Console Supabase > Tokens (type "Personal access
# token" ou "Management API token") et se fournit par l'environnement du
# systeme ou par le gestionnaire de secrets de votre CI :
#
#   supabase login          # invite le jeton, ne le stocke pas dans ce dossier
#   ou  $env:SUPABASE_ACCESS_TOKEN = "..."   # variable de session uniquement
#
# A NE PAS ECRIRE dans ce fichier ni dans `.env.local` : un jeton de gestion
# agit sur le projet depuis le serveur (migrations, lecture de donnees,
# suppression de ressources). S'il a deja ete ecrit sur un poste ou dans une
# archive, considerez-le comme compromis et faites-le revoquer/regenerer par
# son detenteur.
# ---------------------------------------------------------------------------
